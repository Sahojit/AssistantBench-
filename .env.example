GROQ_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here          # Required — used by the independent judge (Gemini) and the optional PDF report recommendation
LANGFUSE_PUBLIC_KEY=your_key_here     # Optional — LangFuse observability
LANGFUSE_SECRET_KEY=your_key_here     # Optional — LangFuse observability
LANGFUSE_HOST=https://us.cloud.langfuse.com
REDIS_URL=redis://localhost:6379/0    # Optional — persists eval results + session stats; falls back to in-memory if unset
